# docker-compose.yml의 Postgres 계정
POSTGRES_USER=nodeloom
POSTGRES_PASSWORD=nodeloom
POSTGRES_DB=nodeloom

# apps/api
DATABASE_URL=postgresql://nodeloom:nodeloom@localhost:5432/nodeloom
PORT=4000

# apps/web: rewrites가 /api/*를 보낼 NestJS 주소
API_URL=http://localhost:4000
# 화면에 시각을 보여 줄 시간대
APP_TIMEZONE=Asia/Seoul

# 인증 (apps/api)
# 관리자 비밀번호의 bcrypt 해시. `pnpm admin:hash`가 출력한 한 줄을 그대로 붙여 넣는다.
# 해시의 `$`가 변수로 해석되지 않도록 반드시 작은따옴표로 감싼다.
ADMIN_PASSWORD_HASH=
# JWT 서명 키(32자 이상). 예: openssl rand -hex 32. 바꾸면 모든 로그인이 풀린다.
JWT_SECRET=

# true면 공개 데모 서버: 로그인 없이 편집, 관리자 로그인 끔, 개수·크기 제한
DEMO_MODE=false

# 실행 엔진 (apps/api)
# 실행 한 번의 전체 시간 제한(초). 기본 300
RUN_TIMEOUT=300
# 연습용 응답(/mock) 주소. 비우면 api 자신(http://localhost:PORT/mock)
MOCK_BASE_URL=
# HTTP 요청 노드가 예외로 요청할 수 있는 내부 IP나 대역, 쉼표로 구분. 예: 192.168.0.10,10.0.0.0/24
HTTP_ALLOW_PRIVATE=
# HTTP 요청 노드에서 {{ $secrets.이름 }}으로 쓸 비밀값. 8자 이상. 실행 기록과 로그에서는 ***로 가린다.
# NODELOOM_SECRET_DISCORD_WEBHOOK=
